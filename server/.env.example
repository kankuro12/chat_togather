PORT=3001
HOST=127.0.0.1
# Application database. MySQL database must exist before starting the API.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=together
DB_USERNAME=root
DB_PASSWORD=
# Optional connection URL; overrides separate MySQL connection fields.
DATABASE_URL=
# SQLite source for import, or local DB when DB_CONNECTION=sqlite.
DB_PATH=data/together.db
# Switch sessions and background jobs together: db or redis.
STORAGE_DRIVER=db
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=together
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost,https://localhost,capacitor://localhost

# Public web/API URLs; OAuth callback URLs must match provider console exactly.
PUBLIC_URL=http://localhost:3001
APP_URL=http://localhost:4200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Test OTP 123456, no SMS; works in production when true.
# Allows signing in as any phone number. Disable after testing.
PHONE_TEST_MODE=false

# FCM (web config is public; service account stays outside source)
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_WEB_CONFIG=
FCM_VAPID_KEY=
# JSON ICE server array; configure TURN for calls across restrictive networks
WEBRTC_ICE_SERVERS=

# Optional Firebase service account (alternative to GOOGLE_APPLICATION_CREDENTIALS)
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Test SMTP settings; no email feature consumes these yet
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Together
